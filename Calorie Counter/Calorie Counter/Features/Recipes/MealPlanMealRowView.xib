                        <constraint firstItem="identity" firstAttribute="leading" secondItem="photo" secondAttribute="trailing" constant="12" id="il" customClass="AdaptiveConstraint" customModule="Calorie_Counter" customModuleProvider="target">
                            <userDefinedRuntimeAttributes>
