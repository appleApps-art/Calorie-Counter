                        <constraint firstItem="identity" firstAttribute="centerY" secondItem="photo" secondAttribute="centerY" id="icy"/>
                        <constraint firstItem="swap" firstAttribute="leading" secondItem="identity" secondAttribute="trailing" constant="8" id="swl"/>
                        <constraint firstAttribute="trailing" secondItem="swap" secondAttribute="trailing" constant="8" id="swr"/>
                        <constraint firstItem="swap" firstAttribute="centerY" secondItem="photo" secondAttribute="centerY" id="swy"/>
