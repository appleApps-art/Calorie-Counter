                <constraint firstItem="img" firstAttribute="centerY" secondItem="root" secondAttribute="centerY" id="iy"/>
                <constraint firstItem="text" firstAttribute="leading" secondItem="img" secondAttribute="trailing" constant="12" id="tl"/>
                <constraint firstItem="text" firstAttribute="centerY" secondItem="root" secondAttribute="centerY" id="ty"/>
                <constraint firstItem="acc" firstAttribute="leading" secondItem="text" secondAttribute="trailing" constant="8" id="al"/>
                <constraint firstAttribute="trailing" secondItem="acc" secondAttribute="trailing" constant="16" id="ar"/>
                <constraint firstItem="acc" firstAttribute="centerY" secondItem="root" secondAttribute="centerY" id="ay"/>
                <constraint firstItem="sep" firstAttribute="leading" secondItem="text" secondAttribute="leading" id="sepl"/>
                <constraint firstAttribute="trailing" secondItem="sep" secondAttribute="trailing" constant="16" id="sepr"/>
                <constraint firstAttribute="bottom" secondItem="sep" secondAttribute="bottom" id="sepb"/>
