                        <segment title="Foods"/>
                    </segments>
                </segmentedControl>
                <stackView opaque="NO" contentMode="scaleToFill" spacing="8" translatesAutoresizingMaskIntoConstraints="NO" id="search-stack" customClass="AdaptiveStackView" customModule="Calorie_Counter" customModuleProvider="target">
