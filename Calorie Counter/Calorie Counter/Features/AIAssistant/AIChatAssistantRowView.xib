<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="23504" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23506"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" customClass="AIChatAssistantRowView" customModule="Calorie_Counter" customModuleProvider="target">
            <connections>
                <outlet property="avatarView" destination="avatar" id="o-avatar"/>
                <outlet property="contentContainer" destination="slot" id="o-slot"/>
            </connections>
        </placeholder>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="root">
            <rect key="frame" x="0.0" y="0.0" width="370" height="80"/>
            <subviews>
                <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" image="BityAIAssistant" translatesAutoresizingMaskIntoConstraints="NO" id="avatar"/>
                <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="slot">
                    <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                </view>
            </subviews>
            <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
            <constraints>
                <constraint firstItem="avatar" firstAttribute="leading" secondItem="root" secondAttribute="leading" id="al"/>
                <constraint firstItem="avatar" firstAttribute="top" secondItem="root" secondAttribute="top" id="at"/>
                <constraint firstItem="avatar" firstAttribute="width" constant="40" id="aw" customClass="AdaptiveConstraint" customModule="Calorie_Counter" customModuleProvider="target">
                    <userDefinedRuntimeAttributes>
                        <userDefinedRuntimeAttribute type="number" keyPath="designConstant">
                            <real key="value" value="40"/>
                        </userDefinedRuntimeAttribute>
                        <userDefinedRuntimeAttribute type="boolean" keyPath="adaptToWidth" value="YES"/>
                    </userDefinedRuntimeAttributes>
                </constraint>
                <constraint firstItem="avatar" firstAttribute="height" constant="40" id="ah" customClass="AdaptiveConstraint" customModule="Calorie_Counter" customModuleProvider="target">
                    <userDefinedRuntimeAttributes>
                        <userDefinedRuntimeAttribute type="number" keyPath="designConstant">
                            <real key="value" value="40"/>
                        </userDefinedRuntimeAttribute>
                        <userDefinedRuntimeAttribute type="boolean" keyPath="adaptToHeight" value="YES"/>
                    </userDefinedRuntimeAttributes>
                </constraint>
                <constraint firstItem="root" firstAttribute="bottom" relation="greaterThanOrEqual" secondItem="avatar" secondAttribute="bottom" id="ab"/>
                <constraint firstItem="slot" firstAttribute="leading" secondItem="avatar" secondAttribute="trailing" constant="8" id="sl" customClass="AdaptiveConstraint" customModule="Calorie_Counter" customModuleProvider="target">
                    <userDefinedRuntimeAttributes>
                        <userDefinedRuntimeAttribute type="number" keyPath="designConstant">
                            <real key="value" value="8"/>
                        </userDefinedRuntimeAttribute>
                        <userDefinedRuntimeAttribute type="boolean" keyPath="adaptToWidth" value="YES"/>
                    </userDefinedRuntimeAttributes>
                </constraint>
                <constraint firstItem="slot" firstAttribute="top" secondItem="root" secondAttribute="top" id="st"/>
                <constraint firstItem="root" firstAttribute="trailing" secondItem="slot" secondAttribute="trailing" id="sr"/>
                <constraint firstItem="root" firstAttribute="bottom" secondItem="slot" secondAttribute="bottom" id="sb"/>
            </constraints>
            <freeformSimulatedSizeMetrics key="simulatedDestinationMetrics"/>
        </view>
    </objects>
    <resources>
        <image name="BityAIAssistant" width="40" height="40"/>
    </resources>
</document>
