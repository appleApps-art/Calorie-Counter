                <outlet property="sexSegmentedControl" destination="sex-seg" id="out-sex"/>
                <outlet property="statusLabel" destination="status-label" id="out-status"/>
                <outlet property="subtitleLabel" destination="sub-label" id="out-sub"/>
                <outlet property="titleLabel" destination="ttl-label" id="out-ttl"/>
