                                            <segments>
                                                <segment title="Sedentary"/>
                                                <segment title="Light"/>
                                                <segment title="Moderate"/>
                                                <segment title="Active"/>
                                                <segment title="Very"/>
                                            </segments>
                                        </segmentedControl>
                                        <textField opaque="NO" contentMode="scaleToFill" horizontalHuggingPriority="248" contentHorizontalAlignment="left" contentVerticalAlignment="center" borderStyle="roundedRect" placeholder="Age" textAlignment="natural" minimumFontSize="17" translatesAutoresizingMaskIntoConstraints="NO" id="age-field">
                                            <constraints>
                                                <constraint firstAttribute="height" constant="48" id="age-h" customClass="AdaptiveConstraint" customModule="Calorie_Counter" customModuleProvider="target">
                                                    <userDefinedRuntimeAttributes>
