                <constraint firstAttribute="bottom" secondItem="gif" secondAttribute="bottom" id="g-b"/>
                <constraint firstItem="title" firstAttribute="centerX" secondItem="root" secondAttribute="centerX" id="t-cx"/>
                <constraint firstItem="title" firstAttribute="bottom" secondItem="root" secondAttribute="centerY" constant="-16" id="t-cy" customClass="AdaptiveConstraint" customModule="Calorie_Counter" customModuleProvider="target">
                    <userDefinedRuntimeAttributes>
