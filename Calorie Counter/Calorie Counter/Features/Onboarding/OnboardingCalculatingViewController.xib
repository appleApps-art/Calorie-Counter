            <subviews>
                <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" translatesAutoresizingMaskIntoConstraints="NO" id="gif" customClass="GIFImageView" customModule="Calorie_Counter" customModuleProvider="target">
