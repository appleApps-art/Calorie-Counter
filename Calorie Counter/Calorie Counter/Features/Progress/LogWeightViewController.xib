                                                <userDefinedRuntimeAttribute type="number" keyPath="designCornerRadius">
                                                    <real key="value" value="24" />
                                                </userDefinedRuntimeAttribute>
                                                <userDefinedRuntimeAttribute type="boolean" keyPath="applyCardShadow" value="YES" />
                                                <userDefinedRuntimeAttribute type="boolean" keyPath="useLiveGlass" value="NO" />
                                            </userDefinedRuntimeAttributes>
                                        </view>
                                    </subviews>
                                    <userDefinedRuntimeAttributes>
                                        <userDefinedRuntimeAttribute type="boolean" keyPath="adaptSpacing" value="NO" />
                                    </userDefinedRuntimeAttributes>
                                </stackView>
                                <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" translatesAutoresizingMaskIntoConstraints="NO" id="lw-dsec">
                                    <subviews>
                                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Log Date" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" translatesAutoresizingMaskIntoConstraints="NO" id="lw-dh" customClass="AdaptiveLabel" customModule="Calorie_Counter" customModuleProvider="target">
                                            <constraints>
                                                <constraint firstAttribute="height" constant="38" id="lw-dhh" />
                                            </constraints>
                                            <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="15" />
                                            <color key="textColor" name="BityTextPrimary" />
                                            <nil key="highlightedColor" />
                                        </label>
                                        <stackView opaque="NO" contentMode="scaleToFill" alignment="center" spacing="10" translatesAutoresizingMaskIntoConstraints="NO" id="lw-drow" customClass="AdaptiveStackView" customModule="Calorie_Counter" customModuleProvider="target">
                                            <subviews>
                                                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Today" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" translatesAutoresizingMaskIntoConstraints="NO" id="lw-dbadge" customClass="AdaptiveLabel" customModule="Calorie_Counter" customModuleProvider="target">
                                                    <constraints>
