                                                <constraint firstItem="lw-card" firstAttribute="trailing" secondItem="lw-slider" secondAttribute="trailing" constant="32" id="lw-sldr" />
                                                <constraint firstItem="lw-card" firstAttribute="bottom" secondItem="lw-slider" secondAttribute="bottom" constant="28" id="lw-sb" />
