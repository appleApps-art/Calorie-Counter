                                                            <color key="backgroundColor" red="0.455" green="0.455" blue="0.502" alpha="0.16" colorSpace="custom" customColorSpace="sRGB" />
                                                            <constraints>
                                                                <constraint firstAttribute="width" constant="4" id="lw-tw4" />
                                                                <constraint firstAttribute="height" constant="4" id="lw-th4" />
                                                            </constraints>
                                                        </view>
                                                    </subviews>
