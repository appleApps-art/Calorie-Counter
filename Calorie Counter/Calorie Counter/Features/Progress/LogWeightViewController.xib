                                                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Enter Weight" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" translatesAutoresizingMaskIntoConstraints="NO" id="lw-sh" customClass="AdaptiveLabel" customModule="Calorie_Counter" customModuleProvider="target">
