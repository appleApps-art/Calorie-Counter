                                                            <constraints>
                                                                <constraint firstAttribute="width" constant="4" id="lw-tw0" />
                                                                <constraint firstAttribute="height" constant="4" id="lw-th0" />
                                                            </constraints>
                                                        </view>
                                                        <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="lw-t1">
                                                            <color key="backgroundColor" red="0.455" green="0.455" blue="0.502" alpha="0.16" colorSpace="custom" customColorSpace="sRGB" />
                                                            <constraints>
                                                                <constraint firstAttribute="width" constant="4" id="lw-tw1" />
                                                                <constraint firstAttribute="height" constant="4" id="lw-th1" />
                                                            </constraints>
