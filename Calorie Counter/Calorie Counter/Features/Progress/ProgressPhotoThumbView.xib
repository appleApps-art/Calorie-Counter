                <constraint firstAttribute="trailing" secondItem="img" secondAttribute="trailing" id="ir"/>
                <constraint firstItem="date" firstAttribute="top" secondItem="img" secondAttribute="bottom" constant="8" id="dt" customClass="AdaptiveConstraint" customModule="Calorie_Counter" customModuleProvider="target">
